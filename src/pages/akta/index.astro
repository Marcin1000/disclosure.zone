---
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import { getCollection } from 'astro:content';
import { overall, STATUS, DOMAIN } from '../../lib/scoring';

const all = (await getCollection('cases')).filter(c => !c.data.draft)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const count = (fn: (d: any) => boolean) => all.filter(c => fn(c.data)).length;
const countries = [...new Set(all.map(c => c.data.country))]
  .map(k => ({ k, n: all.find(c => c.data.country === k)!.data.countryName, c: count(d => d.country === k) }))
  .sort((a, b) => b.c - a.c || a.n.localeCompare(b.n, 'pl'));
---
<Base title="Akta sprawy" description="Wszystkie udokumentowane przypadki UAP w bazie, z oceną dowodową i filtrowaniem po państwie, statusie i rodzaju dowodu.">
  <section class="wrap" style="padding-block:clamp(3rem,7vw,5rem) 2rem">
    <p class="label label--phos" style="margin-bottom:.8rem">Archiwum · {all.length} spraw</p>
    <h1 style="font-size:clamp(2rem,5vw,3.4rem)">Akta sprawy</h1>
    <p class="lead dim" style="max-width:60ch">
      Korpus uporządkowany chronologicznie. Ocena dowodowa liczona z ośmiu osi — im wyższa, tym
      lepiej sprawa jest udokumentowana, a nie tym bardziej jest niezwykła.
    </p>
  </section>

  <section class="wrap" style="padding-bottom:1.5rem">
    <div class="stack" style="--s:.9rem">
      <div>
        <p class="label" style="margin-bottom:.55rem">Status</p>
        <div class="filters" data-group="status">
          <button class="f" data-v="" aria-pressed="true">Wszystkie <b>{all.length}</b></button>
          {Object.entries(STATUS).map(([k, v]) => (
            <button class="f" data-v={k} aria-pressed="false">{v.pl} <b>{count(d => d.status === k)}</b></button>
          ))}
        </div>
      </div>
      <div>
        <p class="label" style="margin-bottom:.55rem">Charakter</p>
        <div class="filters" data-group="domain">
          <button class="f" data-v="" aria-pressed="true">Wszystkie</button>
          {Object.entries(DOMAIN).map(([k, v]) => (
            <button class="f" data-v={k} aria-pressed="false">{v} <b>{count(d => d.domain === k)}</b></button>
          ))}
          <span style="width:1px;height:20px;background:var(--line-2);margin-inline:.4rem"></span>
          <button class="f" data-group-alt="tier" data-v="1" aria-pressed="false">◆ Rdzeń dowodowy <b>{count(d => d.tier === 1)}</b></button>
        </div>
      </div>
      <div>
        <p class="label" style="margin-bottom:.55rem">Państwo</p>
        <div class="filters" data-group="country">
          <button class="f" data-v="" aria-pressed="true">Wszystkie</button>
          {countries.map(c => <button class="f" data-v={c.k} aria-pressed="false">{c.n} <b>{c.c}</b></button>)}
        </div>
      </div>
    </div>
    <p class="label" style="margin-top:1.5rem" data-result>{all.length} spraw</p>
  </section>

  <section class="wrap" style="padding-bottom:5rem">
    <div class="grid grid--3" id="list" style="background:var(--line);border:1px solid var(--line)">
      {all.map(c => (
        <div data-item data-status={c.data.status} data-domain={c.data.domain}
             data-country={c.data.country} data-tier={c.data.tier} style="display:contents">
          <CaseCard href={`/akta/${c.id}`} title={c.data.title} summary={c.data.summary}
            dateDisplay={c.data.dateDisplay} countryName={c.data.countryName}
            status={c.data.status} tier={c.data.tier} scores={c.data.scores} />
        </div>
      ))}
    </div>
    <p class="dim" data-empty hidden style="padding:3rem 0;text-align:center">Brak spraw spełniających te kryteria.</p>
  </section>

  <script>
    const state: Record<string, string> = { status: '', domain: '', country: '', tier: '' };
    const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
    const out = document.querySelector('[data-result]')!;
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;

    function apply() {
      let n = 0;
      for (const it of items) {
        const ok = (['status', 'domain', 'country', 'tier'] as const)
          .every(k => !state[k] || it.dataset[k] === state[k]);
        const card = it.firstElementChild as HTMLElement | null;
        if (card) card.style.display = ok ? '' : 'none';
        if (ok) n++;
      }
      out.textContent = `${n} ${n === 1 ? 'sprawa' : n < 5 ? 'sprawy' : 'spraw'}`;
      empty.hidden = n > 0;
    }

    document.querySelectorAll<HTMLButtonElement>('.f').forEach(btn => {
      btn.addEventListener('click', () => {
        const alt = btn.dataset.groupAlt;
        const group = alt ?? (btn.closest('[data-group]') as HTMLElement).dataset.group!;
        const v = btn.dataset.v!;
        const on = btn.getAttribute('aria-pressed') === 'true';

        if (alt) {
          state.tier = on ? '' : v;
          btn.setAttribute('aria-pressed', String(!on));
        } else {
          state[group] = v;
          const scope = btn.closest('[data-group]')!;
          scope.querySelectorAll('.f:not([data-group-alt])').forEach(b =>
            b.setAttribute('aria-pressed', String(b === btn)));
        }
        apply();
      });
    });
    apply();
  </script>
</Base>
