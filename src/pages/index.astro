---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import { getCollection } from 'astro:content';
import { overall } from '../lib/scoring';
import { claims } from '../data/claims';
import { archives } from '../data/archives';

const all = (await getCollection('cases')).filter(c => !c.data.draft);
const countries = new Set(all.map(c => c.data.country));
const core = all.filter(c => c.data.tier === 1)
  .sort((a, b) => overall(b.data.scores) - overall(a.data.scores));
const years = all.map(c => c.data.date.getFullYear()).filter(y => y > 1900);
const span = `${Math.min(...years)}–${Math.max(...years)}`;

const featured = claims.filter(c =>
  ['nimitz-transmedium', 'rb47-three-sensors', 'gofast-extreme-speed', 'bluebook-701', 'belgian-f16-acceleration', 'rendlesham-radar'].includes(c.id));

const TIERS = [
  { t: 'T1', n: 'Dokument pierwotny', d: 'Raport operacyjny, akta sprawy, protokół z epoki.' },
  { t: 'T2', n: 'Oficjalne oświadczenie', d: 'Potwierdzenie instytucji, komunikat resortu.' },
  { t: 'T3', n: 'Zeznanie pod przysięgą', d: 'Relacja świadka złożona z rygorem prawnym.' },
  { t: 'T4', n: 'Późniejsza relacja', d: 'Wywiad lub rekonstrukcja po latach.' },
  { t: 'T5', n: 'Twierdzenie medialne', d: 'Bez zaplecza dokumentowego.' },
];
---
<Base
  title="disclosure.zone"
  description="Baza przypadków UAP z jawną metodologią oceny dowodów. 55 spraw z 19 państw, rejestr twierdzeń i archiwa państwowe od 1946 roku.">

  <section class="hero">
    <div class="hero__sky"><div class="hero__glow"></div><div class="hero__beam"></div></div>
    <div class="wrap">
      <div class="hero__kicker">
        <i></i>
        <span class="label label--phos">Archiwum otwarte · {span}</span>
      </div>
      <h1>Nierozstrzygnięte<br />nie znaczy<br /><em style="color:var(--phos)">pozaziemskie.</em></h1>
      <p class="lead" style="max-width:56ch;margin-top:1.8rem">
        Problemem UAP nie jest brak przypadków. Problemem jest brak danych.
        Ta baza rozdziela to, co zapisano w dokumencie, od tego, co dopisano później —
        sprawa po sprawie, twierdzenie po twierdzeniu.
      </p>
      <div style="display:flex;gap:.8rem;flex-wrap:wrap;margin-top:2.4rem">
        <a class="btn" href="/akta">Otwórz akta</a>
        <a class="btn btn--ghost" href="/metodologia">Jak to oceniamy</a>
      </div>
    </div>
  </section>

  <section class="wrap section--tight">
    <div class="stats rise">
      <div class="stat"><b>{all.length}</b><span>udokumentowanych<br />spraw</span></div>
      <div class="stat"><b>{countries.size}</b><span>państw<br />w korpusie</span></div>
      <div class="stat"><b>{claims.length}</b><span>twierdzeń<br />w rejestrze</span></div>
      <div class="stat"><b>{archives.length}</b><span>programów<br />państwowych</span></div>
    </div>
  </section>

  <section class="wrap section">
    <div class="grid grid--2" style="gap:1px;background:var(--line);border:1px solid var(--line)">
      <div class="rise" style="background:var(--void-2);padding:clamp(1.6rem,4vw,2.6rem)">
        <p class="label label--phos" style="margin-bottom:1.2rem">Potwierdzone</p>
        <ul style="list-style:none;padding:0;margin:0;font-size:.98rem;line-height:1.7;color:var(--fg-dim)">
          <li>— UAP są realną kategorią raportowanych obserwacji, ciągłą od 1946 r.</li>
          <li>— Kilkanaście państw prowadziło lub prowadzi własne programy badawcze.</li>
          <li>— Pentagon potwierdził autentyczność trzech nagrań Marynarki Wojennej.</li>
          <li>— Część spraw pozostaje nierozstrzygnięta mimo rzetelnych dochodzeń.</li>
          <li>— Fenomen jest globalny, nie amerykański.</li>
        </ul>
      </div>
      <div class="rise" style="background:var(--void-2);padding:clamp(1.6rem,4vw,2.6rem)">
        <p class="label" style="color:var(--stamp-2);margin-bottom:1.2rem">Niepotwierdzone</p>
        <ul style="list-style:none;padding:0;margin:0;font-size:.98rem;line-height:1.7;color:var(--fg-dim)">
          <li>— Że którykolwiek przypadek jest pojazdem pozaziemskim.</li>
          <li>— Że odzyskano jakikolwiek nieziemski statek lub materiał.</li>
          <li>— Że istnieje potwierdzony program inżynierii odwrotnej.</li>
          <li>— Że którykolwiek artefakt wykazano naukowo jako nieziemski.</li>
          <li>— Że ekstremalne osiągi z relacji zostały kiedykolwiek zmierzone.</li>
        </ul>
      </div>
    </div>
    <p class="dim rise" style="margin-top:1.6rem;font-size:.95rem;max-width:62ch">
      Obie kolumny są jednocześnie prawdziwe. Cała trudność tej dziedziny mieści się między nimi —
      i większość publicznej dyskusji polega na udawaniu, że istnieje tylko jedna z nich.
    </p>
  </section>

  <hr class="rule" />

  <section class="wrap section">
    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:2rem;flex-wrap:wrap;margin-bottom:2.5rem">
      <div>
        <p class="label label--phos" style="margin-bottom:.7rem">Rdzeń dowodowy</p>
        <h2 style="margin:0">Sprawy, które przetrwały weryfikację</h2>
      </div>
      <a class="btn btn--ghost" href="/akta">Wszystkie {all.length} spraw</a>
    </div>
    <div class="grid grid--3 rise" style="background:var(--line);border:1px solid var(--line)">
      {core.slice(0, 9).map(c => (
        <CaseCard href={`/akta/${c.id}`} title={c.data.title} summary={c.data.summary}
          dateDisplay={c.data.dateDisplay} countryName={c.data.countryName}
          status={c.data.status} tier={c.data.tier} scores={c.data.scores} />
      ))}
    </div>
  </section>

  <hr class="rule" />

  <section class="wrap section">
    <p class="label label--phos" style="margin-bottom:.7rem">Rejestr twierdzeń</p>
    <h2 style="margin:0 0 .8rem">Mit kontra dokument</h2>
    <p class="lead dim" style="max-width:58ch;margin-bottom:2.2rem">
      Nie sprawy, tylko pojedyncze zdania — każde ze wskazanym pochodzeniem, statusem
      i informacją, co dokładnie by je rozstrzygnęło.
    </p>
    <div class="panel corners rise" style="padding:0">
      {featured.map((c, i) => (
        <div style={`padding:1.25rem clamp(1rem,3vw,1.8rem);${i ? 'border-top:1px solid var(--line)' : ''}`}>
          <div style="display:flex;gap:.7rem;align-items:baseline;flex-wrap:wrap;margin-bottom:.5rem">
            <span class:list={['tier', `tier-${c.originTier}`]}>{c.originTier}</span>
            <span class="mono" style="font-size:.98rem;color:var(--fg)">{c.claim}</span>
          </div>
          <p class="dim" style="margin:0 0 .6rem;font-size:.92rem;max-width:76ch">{c.verdict.split('.')[0]}.</p>
        </div>
      ))}
    </div>
    <a class="btn btn--ghost" href="/twierdzenia" style="margin-top:1.6rem">Pełny rejestr — {claims.length} twierdzeń</a>
  </section>

  <hr class="rule" />

  <section class="wrap section">
    <p class="label label--phos" style="margin-bottom:.7rem">Skala źródeł</p>
    <h2 style="margin:0 0 2.2rem;max-width:20ch">Każde zdanie ma swój poziom</h2>
    <div class="grid rise" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr));background:var(--line);border:1px solid var(--line)">
      {TIERS.map(t => (
        <div style="background:var(--void-2);padding:1.4rem 1.3rem">
          <span class:list={['tier', `tier-${t.t}`]} style="font-size:.7rem;margin-bottom:.9rem;display:inline-block">{t.t}</span>
          <p class="mono" style="margin:0 0 .45rem;font-size:.85rem;color:var(--fg)">{t.n}</p>
          <p class="dim" style="margin:0;font-size:.85rem;line-height:1.5">{t.d}</p>
        </div>
      ))}
    </div>
    <p class="dim rise" style="margin-top:1.6rem;font-size:.95rem;max-width:62ch">
      Roswell i Rendlesham są w większości zbudowane z T4 i T5. Teheran 1976 i Trans-en-Provence
      stoją na T1. Ta różnica jest ważniejsza od kształtu obiektu.
    </p>
  </section>

  <section class="wrap section--tight" style="padding-bottom:5rem">
    <div class="dossier corners rise">
      <div class="dossier__holes"><i></i><i></i><i></i></div>
      <div style="padding-left:2.2rem">
        <p class="dossier__id">Nast. krok</p>
        <h2 style="margin:.6rem 0 1rem;max-width:24ch">Zobacz, gdzie to się działo</h2>
        <p class="dim" style="max-width:56ch;margin-bottom:1.6rem">
          Wszystkie {all.length} spraw naniesionych na mapę świata, z filtrowaniem po państwie.
          Fenomen UAP nie jest amerykański — to widać dopiero na mapie.
        </p>
        <a class="btn" href="/mapa">Otwórz mapę zdarzeń</a>
      </div>
    </div>
  </section>
</Base>
