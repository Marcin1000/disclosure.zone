---
import Base from '../../../layouts/Base.astro';
import Support from '../../../components/Support.astro';
import { records, recordBySlug, recordsForCase, yearLabel, releaseLabel, RELEASES } from '../../../lib/records';
import { getCollection } from 'astro:content';
import { getCases } from '../../../lib/cases';
import { mediaFor } from '../../../lib/media';
import { STILLS, stillTime } from '../../../data/stills';
import { LOCALES, DEFAULT_LANG, path, useT, type Lang } from '../../../i18n';

export function getStaticPaths() {
  return LOCALES.flatMap(l =>
    records.map(r => ({
      params: { lang: l === DEFAULT_LANG ? undefined : l, id: r.slug },
      props: { lang: l, id: r.slug },
    })));
}

const { lang, id } = Astro.props as { lang: Lang; id: string };
const t = useT(lang);
const en = lang === 'en';
const r = recordBySlug.get(id)!;

const all = await getCases(lang);
const citing = all.filter(c => r.cases.includes(c.id));

// Sprawy, które wymieniają rekord w tekście (np. dla porównania), ale nie mają go
// wśród swoich dokumentów w CASE_LINKS. Szukamy po identyfikatorze w kanonicznym
// tekście sprawy, z zerami wiodącymi zdjętymi po obu stronach (D7 i D007 to jedno).
const normId = (s: string) => s.replace(/^([A-Z]+-UAP-[A-Z]*)0*(\d+)/, '$1$2');
const mentioning = new Set<string>();
if (r.id) {
  const want = normId(r.id);
  for (const c of await getCollection('cases')) {
    if (c.data.draft || r.cases.includes(c.id)) continue;
    const text = `${JSON.stringify(c.data)}\n${c.body ?? ''}`;
    for (const m of text.match(/\b[A-Z]{2,6}-UAP-[A-Z]{0,3}\d+\b/g) ?? []) {
      if (normId(m) === want) { mentioning.add(c.id); break; }
    }
  }
}
const mentions = all.filter(c => mentioning.has(c.id));

const relMeta = r.release ? RELEASES[r.release] : null;
const relText = r.release
  ? `${r.release} · ${releaseLabel(r.release, lang)}${relMeta && !relMeta.dateKnown ? ` (${t('rec.releaseUndated')})` : ''}`
  : null;

/**
 * Cytowanie wskazuje materiał u wydawcy, nie nasz rejestr. Nasz adres jest
 * dopiskiem, żeby dało się wrócić po ścieżkę, ale to wydawca jest źródłem.
 */
const citation = [
  [r.id, r.title].filter(Boolean).join(', '),
  r.agencyName ?? r.agency,
  r.release ? `PURSUE release ${r.release}` : null,
  r.source,
].filter(Boolean).join('. ') + (en ? ' (accessed: [date])' : ' (dostęp: [data])');

const related = r.related
  .map(x => ({ rel: x.rel, rec: recordBySlug.get(x.slug)! }))
  .filter(x => x.rec);
/** Kopie tego samego tekstu dostają jedną notkę, części jednego dokumentu drugą. */
const relCopy = related.some(x => ['same', 'edition', 'part', 'whole'].includes(x.rel));
const relSeq = related.some(x => x.rel === 'next' || x.rel === 'prev');
const relPair = related.some(x => x.rel === 'report' || x.rel === 'recording');
/**
 * Indeks dał tylko stronę wydania, a adres wzięliśmy ze spisu wydawcy. Sprawdzane przed
 * indexedReport, bo nagrania z tego spisu też mają sourceAsIndexed.
 */
const fromListing = r.fromListing;
/** Przy nagraniu indeks podawał raport, który istnieje; przy D20 adres, którego nie ma. */
const indexedReport = !fromListing && r.kind === 'recording' && !!r.sourceAsIndexed;
/** Przy przesunięciu oba adresy działają, tylko indeks podlinkował inny plik z zestawu. */
const asIndexedKey = fromListing ? 'rec.asIndexedLanding'
  : indexedReport ? 'rec.asIndexedReport' : r.linkShift ? 'rec.asIndexedShift' : 'rec.asIndexed';
const asIndexedNote = fromListing ? (r.kind === 'recording' ? 'rec.asIndexedLandingVideoNote' : 'rec.asIndexedLandingNote')
  : indexedReport ? null : r.linkShift ? 'rec.asIndexedShiftNote' : 'rec.asIndexedNote';

const media = mediaFor(r);
const still = r.id && r.kind === 'recording' ? STILLS[r.id] : undefined;
/** Wydawca sam nazywa te pliki renderingiem albo rekonstrukcją, nie zapisem. */
const synthetic = /digital render|digital recreation/i.test(r.title);
const isImage = r.kind === 'image';

const openLabel = r.kind === 'recording' ? t('films.watch')
  : r.kind === 'image' ? t('rec.openImage')
  : r.sourceKind === 'file' || r.sourceKind === 'dead' ? t('rec.open')
  : r.sourceKind === 'page' ? t('rec.openPage') : t('rec.openRelease');
---
<Base title={!r.id ? r.title : en ? `${r.id} — ${r.title}` : `${r.id}, ${r.title}`}
      description={t('rec.assessmentNote')} lang={lang} rest={`/records/${r.slug}`}>
  <article>
    <header class="wrap" style="padding-block:clamp(2.5rem,6vw,4.5rem) 0">
      <div class="dossier corners">
        <div class="dossier__holes"><i></i><i></i><i></i><i></i></div>
        <div style="padding-left:2.2rem">
          <p class="dossier__id" style="margin:0">{t('rec.file')} / {r.id ?? r.slug}</p>
          <h1 class="rec__title" style="font-size:clamp(1.55rem,3.6vw,2.5rem);margin:1rem 0 .4rem">{r.title}</h1>
          <p class="label" style="margin:0">{t('rec.titleNote')}</p>
          <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:1.6rem">
            <span class="chip">{t(`records.kind.${r.kind}`)}</span>
            {r.release && <span class="chip">{t('records.f.release')} {r.release}</span>}
            <span class:list={['chip', r.sourceKind === 'file' || r.sourceKind === 'page' ? '' : 'chip--amber']}>
              {t(`records.link.${r.sourceKind}`)}
            </span>
          </div>
        </div>
      </div>
    </header>

    <section class="wrap wrap--read" style="padding-block:2.5rem 0">
      <div class="meta">
        {r.id && r.idFrom === 'file' && (
          <div class="meta__row"><span class="meta__k">{t('rec.meta.id')}</span>
            <span class="meta__v"><span class="mono" style="font-size:.9rem">{r.id}</span>
              <span class="dim" style="font-size:.85rem"> ({t('rec.meta.idNote')})</span></span></div>
        )}
        {(r.agencyName || r.agency) && (
          <div class="meta__row"><span class="meta__k">{t('rec.meta.agency')}</span>
            <span class="meta__v">{r.agencyName ?? r.agency}{r.agencyName && r.agency ? ` (${r.agency})` : ''}</span></div>
        )}
        {relText && (
          <div class="meta__row"><span class="meta__k">{t('rec.meta.release')}</span>
            <span class="meta__v">{relText}</span></div>
        )}
        {r.place && (
          <div class="meta__row"><span class="meta__k">{t('rec.meta.place')}</span>
            <span class="meta__v">{r.place}</span></div>
        )}
        {r.documentSays && (
          <div class="meta__row"><span class="meta__k">{t('rec.meta.docSays')}</span>
            <span class="meta__v">{r.documentSays.place}{r.documentSays.year ? `, ${r.documentSays.year}` : ''}
              <span class="dim" style="font-size:.85rem"> ({t(`rec.docSays.${r.documentSays.placeFrom}`)})</span></span></div>
        )}
        {yearLabel(r) && (
          <div class="meta__row"><span class="meta__k">{t('rec.meta.year')}</span>
            <span class="meta__v mono">{yearLabel(r)}</span></div>
        )}
        {r.series && (
          <div class="meta__row"><span class="meta__k">{t('rec.meta.series')}</span>
            <span class="meta__v">NARA RG {r.series.rg} · {r.series.name}
              <span class="dim" style="font-size:.85rem"> ({t('rec.meta.seriesNote')})</span></span></div>
        )}
        {r.publisher && (
          <div class="meta__row"><span class="meta__k">{t('rec.meta.publisher')}</span>
            <span class="meta__v mono" style="font-size:.9rem">{r.publisher}</span></div>
        )}
        {r.format && (
          <div class="meta__row"><span class="meta__k">{t('rec.meta.format')}</span>
            <span class="meta__v mono" style="font-size:.9rem">{r.format.toUpperCase()}</span></div>
        )}
      </div>
    </section>

    {(media.poster || media.clip) && (
      <section class="wrap wrap--read" style="padding-block:2.5rem 0">
        <p class="label label--phos" style="margin-bottom:.8rem">{isImage ? t('rec.image') : t('rec.still')}</p>
        <div class="panel corners" style="padding:0;overflow:hidden">
          {media.clip
            ? <video controls preload="none" playsinline poster={media.poster ?? undefined}
                     style="display:block;width:100%;height:auto;background:#05090A">
                <source src={media.clip} type="video/mp4" />
              </video>
            : r.source
              ? <a class="still" href={r.source} rel="noopener" aria-label={openLabel}>
                  <img src={media.poster!} alt="" width={media.w ?? undefined} height={media.h ?? undefined} />
                  <span class:list={['play', isImage && 'play--out']} aria-hidden="true"></span>
                </a>
              : <span class="still"><img src={media.poster!} alt=""
                     width={media.w ?? undefined} height={media.h ?? undefined} /></span>}
        </div>
        <p class="dim" style="margin:.9rem 0 0;font-size:.9rem">{isImage ? t('rec.imageNote') : still && still.object !== 'audio' ? t('rec.stillAt', { t: stillTime(still.at, lang) }) : t('rec.stillNote')}</p>
        {still && still.object !== 'shown' && (
          <p class="dim" style="margin:.6rem 0 0;font-size:.9rem;color:var(--amber)">{t(`rec.still.${still.object}`)}</p>
        )}
        {synthetic && (
          <p class="dim" style="margin:.9rem 0 0;font-size:.9rem;color:var(--amber)">
            <strong style="color:var(--amber)">{t('rec.synthetic')}.</strong> {t('rec.syntheticNote')}
          </p>
        )}
      </section>
    )}

    <section class="wrap wrap--read" style="padding-block:2.5rem 0">
      <div class="panel panel--pad corners">
        {r.source
          ? <>
              <a class="btn" href={r.source} rel="noopener">{openLabel}</a>
              <p class="mono" style="margin:1rem 0 0;font-size:.76rem;color:var(--fg-faint);overflow-wrap:anywhere">{r.source}</p>
              {r.sourceKind === 'landing' && <p class="dim" style="margin:1rem 0 0;font-size:.92rem">{t('rec.landingNote')}</p>}
              {r.sourceKind === 'dead' && <p class="dim" style="margin:1rem 0 0;font-size:.92rem">{t('rec.deadNote')}</p>}
              {r.sourceAsIndexed && (
                <p class="dim" style="margin:1rem 0 0;font-size:.92rem">{t(asIndexedKey)}
                  <span class="mono" style="display:block;font-size:.76rem;color:var(--fg-faint);overflow-wrap:anywhere;margin-top:.3rem">{r.sourceAsIndexed}</span>
                  {asIndexedNote && t(asIndexedNote)}</p>
              )}
            </>
          : <p class="dim" style="margin:0;font-size:.95rem">{t('rec.noneNote')}</p>}
      </div>
    </section>

    {r.illegible && (
      <section class="wrap wrap--read" style="padding-block:2.5rem 0">
        <p class="label" style="margin-bottom:.7rem;color:var(--amber)">{t('rec.illegible')}</p>
        <p class="dim" style="margin:0;max-width:66ch">{t(`rec.illegible.${r.illegible}`)}</p>
      </section>
    )}

    {related.length > 0 && (
      <section class="wrap wrap--read" style="padding-block:2.5rem 0">
        <p class="label label--phos" style="margin-bottom:.7rem">{t('rec.related')}</p>
        <ul style="margin:0;padding-left:1.1rem">
          {related.map(({ rel, rec }) => (
            <li style="margin-bottom:.4rem">
              {t(`rec.rel.${rel}`)} <a href={path(lang, `/records/${rec.slug}`)}>{rec.id ?? rec.slug}</a>
              <span class="dim">, {rec.title}{rec.release ? ` · ${t('records.f.release')} ${rec.release}` : ''}</span>
            </li>
          ))}
        </ul>
        {relCopy && <p class="dim" style="margin:.8rem 0 0;font-size:.9rem;max-width:66ch">{t('rec.relNote')}</p>}
        {relSeq && <p class="dim" style="margin:.8rem 0 0;font-size:.9rem;max-width:66ch">{t('rec.relSeqNote')}</p>}
        {relPair && <p class="dim" style="margin:.8rem 0 0;font-size:.9rem;max-width:66ch">{t('rec.relPairNote')}</p>}
      </section>
    )}

    <section class="wrap wrap--read" style="padding-block:2.5rem 0">
      <p class="label label--phos" style="margin-bottom:.7rem">{t('rec.assessment')}</p>
      <p class="dim" style="margin:0;max-width:66ch">{t('rec.assessmentNote')}</p>
      <p style="margin:1.3rem 0 0"><a class="btn btn--ghost" href={path(lang, '/methodology')}>{t('nav.method')}</a></p>
    </section>

    <section class="wrap wrap--read" style="padding-block:2.5rem 0">
      <p class="label label--phos" style="margin-bottom:.7rem">{t('rec.cases')}</p>
      {citing.length
        ? <ul style="margin:0;padding-left:1.1rem">
            {citing.map(c => (
              <li style="margin-bottom:.4rem">
                <a href={path(lang, `/cases/${c.id}`)}>{c.data.title}</a>
                <span class="dim"> · {c.data.dateDisplay}</span>
              </li>
            ))}
          </ul>
        : <p class="dim" style="margin:0">{t(mentions.length ? 'rec.noCasesListed' : 'rec.noCases')}</p>}
      {mentions.length > 0 && <>
        <p class="label" style="margin:1.6rem 0 .5rem">{t('rec.mentioned')}</p>
        <p class="dim" style="margin:0 0 .7rem;font-size:.92rem">{t('rec.mentionedNote')}</p>
        <ul style="margin:0;padding-left:1.1rem">
          {mentions.map(c => (
            <li style="margin-bottom:.4rem">
              <a href={path(lang, `/cases/${c.id}`)}>{c.data.title}</a>
              <span class="dim"> · {c.data.dateDisplay}</span>
            </li>
          ))}
        </ul>
      </>}
    </section>

    <section class="wrap wrap--read prose" style="padding-block:2.5rem">
      <h2 style="margin-top:0">{t('rec.cite')}</h2>
      <div class="cite">
        <p class="cite__txt" id="cite">{citation}</p>
        <button class="btn btn--ghost cite__btn" type="button" data-copy="cite"
                data-done={t('cite.copied')} hidden>{t('cite.copy')}</button>
      </div>
    </section>

    <section class="wrap wrap--read" style="padding-block:0 5rem">
      <Support lang={lang} context="record" />
      <p style="margin-top:2rem"><a class="btn btn--ghost" href={path(lang, '/records')}>{t('rec.back')}</a></p>
    </section>
  </article>

  <script>
    for (const btn of document.querySelectorAll('[data-copy]')) {
      const el = document.getElementById(btn.getAttribute('data-copy'));
      if (!el || !navigator.clipboard) continue;
      const idle = btn.textContent;
      btn.hidden = false;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(el.textContent.trim());
          btn.textContent = btn.getAttribute('data-done');
          setTimeout(() => { btn.textContent = idle; }, 1800);
        } catch { /* odmowa schowka nie jest błędem strony */ }
      });
    }
  </script>
</Base>
