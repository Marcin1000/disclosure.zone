---
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import HeroScope from '../../components/HeroScope.astro';
import { getCases } from '../../lib/cases';
import { overall, TIER_LABEL, TIER_DESC, bi } from '../../lib/scoring';
import { claims } from '../../data/claims';
import { archives } from '../../data/archives';
import { langParams, path, useT, type Lang } from '../../i18n';

export function getStaticPaths() { return langParams(); }
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);

const all = await getCases(lang);
const countries = new Set(all.map(c => c.data.country));
const core = all.filter(c => c.data.tier === 1).sort((a, b) => overall(b.data.scores) - overall(a.data.scores));
const years = all.map(c => c.data.date.getFullYear());
const span = `${Math.min(...years)}–${Math.max(...years)}`;

const featured = claims.filter(c => ['nimitz-transmedium', 'rb47-three-sensors', 'gofast-extreme-speed',
  'bluebook-701', 'belgian-f16-acceleration', 'rendlesham-radar'].includes(c.id));

const CONFIRMED = {
  en: ['UAP are a real category of reported observation, continuous since 1946.',
       'A dozen-plus states ran or still run their own investigative programmes.',
       'The Pentagon confirmed the authenticity of three US Navy recordings.',
       'Some cases remain unresolved despite rigorous investigation.',
       'The phenomenon is global, not American.'],
  pl: ['UAP są realną kategorią raportowanych obserwacji, ciągłą od 1946 r.',
       'Kilkanaście państw prowadziło lub prowadzi własne programy badawcze.',
       'Pentagon potwierdził autentyczność trzech nagrań Marynarki Wojennej.',
       'Część spraw pozostaje nierozstrzygnięta mimo rzetelnych dochodzeń.',
       'Fenomen jest globalny, nie amerykański.'],
}[lang];

const UNCONFIRMED = {
  en: ['That any case involves an extraterrestrial craft.',
       'That any non-terrestrial craft or material was ever recovered.',
       'That a confirmed reverse-engineering programme exists.',
       'That any artefact has been scientifically shown to be non-terrestrial.',
       'That the extreme performance in the accounts was ever measured.'],
  pl: ['Że którykolwiek przypadek jest pojazdem pozaziemskim.',
       'Że odzyskano jakikolwiek nieziemski statek lub materiał.',
       'Że istnieje potwierdzony program inżynierii odwrotnej.',
       'Że którykolwiek artefakt wykazano naukowo jako nieziemski.',
       'Że ekstremalne osiągi z relacji zostały kiedykolwiek zmierzone.'],
}[lang];
---
<Base title="disclosure.zone" description={t('site.desc')} lang={lang} rest="/">
  <section class="hero">
    <div class="hero__sky"><div class="hero__glow"></div><div class="hero__beam"></div></div>
    <div class="wrap hero__grid">
      <div>
        <div class="hero__kicker"><i></i><span class="label label--phos">{t('home.kicker')} · {span}</span></div>
        <h1>{t('home.h1a')}<br />{t('home.h1b')}<br /><em style="color:var(--phos)">{t('home.h1c')}</em></h1>
        <p class="lead hero__lead">{t('home.lead')}</p>
        <div class="hero__cta">
          <a class="btn" href={path(lang, '/cases')}>{t('home.cta1')}</a>
          <a class="btn btn--ghost" href={path(lang, '/methodology')}>{t('home.cta2')}</a>
        </div>
      </div>
      <HeroScope lang={lang}
                 blips={core.map(c => ({ id: c.id, title: c.data.title, lon: c.data.lon,
                                         year: c.data.date.getFullYear(), status: c.data.status }))} />
    </div>
  </section>

  <section class="wrap section--tight">
    <div class="stats rise">
      <div class="stat"><b>{all.length}</b><span set:html={t('home.stat.cases')} /></div>
      <div class="stat"><b>{countries.size}</b><span set:html={t('home.stat.countries')} /></div>
      <div class="stat"><b>{claims.length}</b><span set:html={t('home.stat.claims')} /></div>
      <div class="stat"><b>{archives.length}</b><span set:html={t('home.stat.programs')} /></div>
    </div>
  </section>

  <section class="wrap section">
    <div class="grid grid--2" style="gap:1px;background:var(--line);border:1px solid var(--line)">
      <div class="rise" style="background:var(--void-2);padding:clamp(1.6rem,4vw,2.6rem)">
        <p class="label label--phos" style="margin-bottom:1.2rem">{t('home.confirmed')}</p>
        <ul style="list-style:none;padding:0;margin:0;font-size:.98rem;line-height:1.7;color:var(--fg-dim)">
          {CONFIRMED.map(x => <li>{lang === 'en' ? '— ' : '· '}{x}</li>)}
        </ul>
      </div>
      <div class="rise" style="background:var(--void-2);padding:clamp(1.6rem,4vw,2.6rem)">
        <p class="label" style="color:var(--stamp-2);margin-bottom:1.2rem">{t('home.unconfirmed')}</p>
        <ul style="list-style:none;padding:0;margin:0;font-size:.98rem;line-height:1.7;color:var(--fg-dim)">
          {UNCONFIRMED.map(x => <li>{lang === 'en' ? '— ' : '· '}{x}</li>)}
        </ul>
      </div>
    </div>
    <p class="dim rise" style="margin-top:1.6rem;font-size:.95rem;max-width:66ch">{t('home.bothTrue')}</p>
  </section>

  <hr class="rule" />

  <section class="wrap section">
    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:2rem;flex-wrap:wrap;margin-bottom:2.5rem">
      <div>
        <p class="label label--phos" style="margin-bottom:.7rem">{t('home.coreKicker')}</p>
        <h2 style="margin:0">{t('home.coreH')}</h2>
      </div>
      <a class="btn btn--ghost" href={path(lang, '/cases')}>{t('home.allCases', { n: all.length })}</a>
    </div>
    <div class="grid grid--3 rise" style="background:var(--line);border:1px solid var(--line)">
      {core.slice(0, 9).map(c => (
        <CaseCard lang={lang} href={path(lang, `/cases/${c.id}`)} title={c.data.title} summary={c.data.summary}
          dateDisplay={c.data.dateDisplay} countryName={c.data.countryName}
          status={c.data.status} tier={c.data.tier} scores={c.data.scores} />
      ))}
    </div>
  </section>

  <hr class="rule" />

  <section class="wrap section">
    <p class="label label--phos" style="margin-bottom:.7rem">{t('home.claimsKicker')}</p>
    <h2 style="margin:0 0 .8rem">{t('home.claimsH')}</h2>
    <p class="lead dim" style="max-width:60ch;margin-bottom:2.2rem">{t('home.claimsLead')}</p>
    <div class="panel corners rise" style="padding:0">
      {featured.map((c, i) => (
        <div style={`padding:1.25rem clamp(1rem,3vw,1.8rem);${i ? 'border-top:1px solid var(--line)' : ''}`}>
          <div style="display:flex;gap:.7rem;align-items:baseline;flex-wrap:wrap;margin-bottom:.5rem">
            <span class:list={['tier', `tier-${c.originTier}`]}>{c.originTier}</span>
            <span class="mono" style="font-size:.98rem;color:var(--fg)">{c.claim[lang]}</span>
          </div>
          <p class="dim" style="margin:0;font-size:.92rem;max-width:78ch">{c.verdict[lang].split('. ')[0]}.</p>
        </div>
      ))}
    </div>
    <a class="btn btn--ghost" href={path(lang, '/claims')} style="margin-top:1.6rem">{t('home.claimsCta', { n: claims.length })}</a>
  </section>

  <hr class="rule" />

  <section class="wrap section">
    <p class="label label--phos" style="margin-bottom:.7rem">{t('home.tierKicker')}</p>
    <h2 style="margin:0 0 2.2rem;max-width:22ch">{t('home.tierH')}</h2>
    <div class="grid rise" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr));background:var(--line);border:1px solid var(--line)">
      {(['T1','T2','T3','T4','T5'] as const).map(k => (
        <div style="background:var(--void-2);padding:1.4rem 1.3rem">
          <span class:list={['tier', `tier-${k}`]} style="font-size:.7rem;margin-bottom:.9rem;display:inline-block">{k}</span>
          <p class="mono" style="margin:0 0 .45rem;font-size:.85rem;color:var(--fg)">{bi(TIER_LABEL[k], lang)}</p>
          <p class="dim" style="margin:0;font-size:.85rem;line-height:1.5">{bi(TIER_DESC[k], lang)}</p>
        </div>
      ))}
    </div>
    <p class="dim rise" style="margin-top:1.6rem;font-size:.95rem;max-width:66ch">{t('home.tierNote')}</p>
  </section>

  <section class="wrap section--tight" style="padding-bottom:5rem">
    <div class="dossier corners rise">
      <div class="dossier__holes"><i></i><i></i><i></i></div>
      <div style="padding-left:2.2rem">
        <p class="dossier__id">{t('home.mapKicker')}</p>
        <h2 style="margin:.6rem 0 1rem;max-width:26ch">{t('home.mapH')}</h2>
        <p class="dim" style="max-width:60ch;margin-bottom:1.6rem">{t('home.mapLead', { n: all.length })}</p>
        <a class="btn" href={path(lang, '/map')}>{t('home.mapCta')}</a>
      </div>
    </div>
  </section>
</Base>
