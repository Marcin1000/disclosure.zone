---
import Base from '../../layouts/Base.astro';
import { langParams, path, useT, type Lang } from '../../i18n';

export function getStaticPaths() { return langParams(); }
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const en = lang === 'en';

const L = en ? {
  kicker: 'Sensor sanity toolkit',
  h1: 'A camera does not measure speed',
  lead: 'The single most common error in UAP discussion is reading a velocity off a video. A camera records the projection of a trajectory onto an observation plane, from a moving platform, at an unknown range. Change one assumption about range and the answer changes by an order of magnitude. Here you can do it yourself.',
  caseTitle: 'Worked example: GOFAST, January 2015',
  caseLead: 'One of the three US Navy recordings whose authenticity the Pentagon confirmed. It appears to show a small object racing just above the ocean. The values below are taken from the aircraft’s own head-up display, visible on the footage.',
  assumeH: 'Assumed target altitude',
  assumeHelp: 'This is the one number the video does not give you. Everything else is on the HUD. Drag it.',
  obsAlt: 'Observer altitude',
  angle: 'Sensor depression angle',
  obsSpeed: 'Observer ground speed',
  rate: 'Tracked angular rate',
  outRange: 'Range to target',
  outApparent: 'Apparent transverse speed',
  outParallax: 'Own-motion (parallax) component',
  outTarget: 'Implied target speed',
  verdictTitle: 'What that means',
  presetSurface: 'Assume: at the surface',
  presetReal: 'Assume: at altitude (the resolved case)',
  reset: 'Reset',
  diagramLabel: 'Observation geometry',
  seaLevel: 'Sea level',
  observer: 'Observer',
  target: 'Target',
  legLos: 'line of sight',
  legGhost: 'the same line, moments earlier — this rotation is what looks like target motion',
  legAng: 'depression angle',
  assumptionsTitle: 'Assumptions of this model — read them',
  bokehTitle: 'Aperture shape, not object shape',
  bokehAlt: 'Defocused points of light taking the shape of the selected aperture',
  bokehLead: 'A defocused point of light takes the shape of the lens aperture. A night-vision device with a triangular aperture turns every distant light into a triangle. This is why the USS Russell “pyramids” are pyramids.',
  bokehPick: 'Aperture',
  angularTitle: 'Angular size proves nothing about size',
  angularLead: 'The same frame is consistent with a small object nearby and a large object far away. Photometry narrows the interval; it never closes it. Drag the distance.',
  angDistance: 'Assumed distance',
  angSize: 'Implied object diameter',
  angRef: 'Airbus A320 · 36 m span',
  angCompareAlt: 'The implied object next to an airliner drawn to the same scale',
  footer: 'This toolkit is deliberately simple and states its assumptions. It is a teaching model, not a forensic tool — it demonstrates the sensitivity of the result to one unknown, which is the entire point.',
} : {
  kicker: 'Kalkulator zdrowego rozsądku',
  h1: 'Kamera nie mierzy prędkości',
  lead: 'Najczęstszy błąd w dyskusji o UAP to odczytywanie prędkości z nagrania. Kamera rejestruje rzut trajektorii na płaszczyznę obserwacji, z ruchomej platformy, przy nieznanej odległości. Zmień jedno założenie o odległości, a wynik zmieni się o rząd wielkości. Tutaj możesz to zrobić sam.',
  caseTitle: 'Przykład: GOFAST, styczeń 2015',
  caseLead: 'Jedno z trzech nagrań Marynarki Wojennej USA, których autentyczność potwierdził Pentagon. Wygląda na małym obiekcie pędzącym tuż nad oceanem. Wartości poniżej pochodzą z wyświetlacza samolotu, widocznego na nagraniu.',
  assumeH: 'Zakładana wysokość obiektu',
  assumeHelp: 'To jedyna liczba, której nagranie nie podaje. Cała reszta jest na wyświetlaczu. Przeciągnij suwak.',
  obsAlt: 'Wysokość obserwatora',
  angle: 'Kąt zejścia linii obserwacji',
  obsSpeed: 'Prędkość obserwatora nad ziemią',
  rate: 'Zmierzona prędkość kątowa',
  outRange: 'Odległość do obiektu',
  outApparent: 'Pozorna prędkość poprzeczna',
  outParallax: 'Składowa ruchu własnego (paralaksa)',
  outTarget: 'Wynikowa prędkość obiektu',
  verdictTitle: 'Co to znaczy',
  presetSurface: 'Załóż: przy powierzchni',
  presetReal: 'Załóż: na wysokości (sprawa rozwiązana)',
  reset: 'Reset',
  diagramLabel: 'Geometria obserwacji',
  seaLevel: 'Poziom morza',
  observer: 'Obserwator',
  target: 'Obiekt',
  legLos: 'linia obserwacji',
  legGhost: 'ta sama linia chwilę wcześniej: to jej obrót wygląda jak ruch obiektu',
  legAng: 'kąt zejścia',
  assumptionsTitle: 'Założenia tego modelu, przeczytaj je',
  bokehTitle: 'Kształt przysłony, nie kształt obiektu',
  bokehAlt: 'Rozogniskowane punkty świetlne przyjmujące kształt wybranej przysłony',
  bokehLead: 'Rozogniskowany punkt świetlny przyjmuje kształt przysłony obiektywu. Noktowizor z trójkątną przysłoną zamienia każde odległe światło w trójkąt. Dlatego „piramidy” z USS Russell są piramidami.',
  bokehPick: 'Przysłona',
  angularTitle: 'Rozmiar kątowy nic nie mówi o rozmiarze',
  angularLead: 'Ten sam kadr jest zgodny z małym obiektem blisko i dużym daleko. Fotometria zawęża przedział, nigdy go nie zamyka. Przeciągnij odległość.',
  angRef: 'Airbus A320, rozpiętość 36 m',
  angCompareAlt: 'Wyliczony obiekt obok samolotu narysowanego w tej samej skali',
  angDistance: 'Zakładana odległość',
  angSize: 'Wynikowa średnica obiektu',
  footer: 'Ten kalkulator jest celowo prosty i podaje swoje założenia. To model dydaktyczny, nie narzędzie śledcze, pokazuje czułość wyniku na jedną niewiadomą, i o to właśnie chodzi.',
};

const ASSUMPTIONS = en ? [
  'The line of sight lies in a vertical plane; the observer’s velocity is treated as perpendicular to it. Real geometry has a crossing angle that reduces the parallax term.',
  'A flat Earth over these distances and no atmospheric refraction — both negligible at this scale.',
  'The angular rate is the rate of rotation of the line of sight, taken from tracking the object across the frame.',
  'The result is the transverse component of the target’s velocity. Motion directly toward or away from the observer is invisible to this method.',
] : [
  'Linia obserwacji leży w płaszczyźnie pionowej, a prędkość obserwatora traktujemy jako do niej prostopadłą. Rzeczywista geometria ma kąt skrzyżowania, który zmniejsza człon paralaksy.',
  'Płaska Ziemia na tych dystansach i brak refrakcji atmosferycznej, oba pomijalne w tej skali.',
  'Prędkość kątowa to tempo obrotu linii obserwacji, zmierzone ze śledzenia obiektu w kadrze.',
  'Wynik to poprzeczna składowa prędkości obiektu. Ruch wprost do obserwatora lub od niego jest dla tej metody niewidoczny.',
];
---
<Base title={en ? 'Sensor sanity toolkit' : 'Kalkulator zdrowego rozsądku'}
      description={L.lead} lang={lang} rest="/toolkit">

  <section class="wrap" style="padding-block:clamp(2.5rem,6vw,4.5rem) 1.5rem">
    <p class="label label--phos" style="margin-bottom:.8rem">{L.kicker}</p>
    <h1 style="font-size:clamp(2rem,5.4vw,3.6rem);max-width:16ch">{L.h1}</h1>
    <p class="lead dim" style="max-width:66ch">{L.lead}</p>
  </section>

  <section class="wrap" style="padding-bottom:1.5rem">
    <div class="panel corners" style="padding:clamp(1.3rem,3vw,2rem)">
      <p class="label label--phos" style="margin:0 0 .5rem">{L.caseTitle}</p>
      <p class="dim" style="max-width:70ch;margin:0 0 1.8rem;font-size:.95rem">{L.caseLead}</p>

      <div class="tk">
        <div class="tk__controls">
          <div class="tk__f tk__f--hero">
            <label for="ht"><span>{L.assumeH}</span><output id="ht-out">13 000 ft</output></label>
            <input id="ht" type="range" min="0" max="24000" step="250" value="13000" />
            <p class="tk__help">{L.assumeHelp}</p>
          </div>
          <div class="tk__f">
            <label for="ho"><span>{L.obsAlt}</span><output id="ho-out">25 000 ft</output></label>
            <input id="ho" type="range" min="10000" max="35000" step="500" value="25000" />
          </div>
          <div class="tk__f">
            <label for="th"><span>{L.angle}</span><output id="th-out">22°</output></label>
            <input id="th" type="range" min="5" max="60" step="0.5" value="22" />
          </div>
          <div class="tk__f">
            <label for="vo"><span>{L.obsSpeed}</span><output id="vo-out">369 kt</output></label>
            <input id="vo" type="range" min="0" max="600" step="1" value="369" />
          </div>
          <div class="tk__f">
            <label for="om"><span>{L.rate}</span><output id="om-out">1.14 °/s</output></label>
            <input id="om" type="range" min="0.05" max="4" step="0.01" value="1.14" />
          </div>
          <div class="filters filters--stack" style="margin-top:.4rem">
            <button class="f" data-preset="surface">{L.presetSurface}</button>
            <button class="f" data-preset="real">{L.presetReal}</button>
            <button class="f" data-preset="reset">{L.reset}</button>
          </div>
        </div>

        <div class="tk__vis">
          <svg viewBox="0 0 520 300" class="tk__svg" role="img" aria-label={L.diagramLabel}>
            <defs>
              <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#080F11"/>
                <stop offset=".62" stop-color="#0B1B1E"/>
                <stop offset="1" stop-color="#123036"/>
              </linearGradient>
              <linearGradient id="sea" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#2E7A82"/>
                <stop offset=".28" stop-color="#17505A"/>
                <stop offset="1" stop-color="#08252A"/>
              </linearGradient>
              <linearGradient id="horizonGlow" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="var(--phos)" stop-opacity="0"/>
                <stop offset="1" stop-color="var(--phos)" stop-opacity=".26"/>
              </linearGradient>
              <linearGradient id="spec" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="var(--phos-2)" stop-opacity="0"/>
                <stop offset=".5" stop-color="var(--phos-2)" stop-opacity=".22"/>
                <stop offset="1" stop-color="var(--phos-2)" stop-opacity="0"/>
              </linearGradient>
              <linearGradient id="losg" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="var(--phos-2)"/>
                <stop offset="1" stop-color="var(--phos-dim)"/>
              </linearGradient>
              <radialGradient id="glow">
                <stop offset="0" stop-color="var(--phos)" stop-opacity=".38"/>
                <stop offset="1" stop-color="var(--phos)" stop-opacity="0"/>
              </radialGradient>
              <clipPath id="plot"><rect x="52" y="8" width="460" height="292"/></clipPath>
            </defs>

            <rect x="0" y="0" width="520" height="300" fill="url(#sky)"/>

            {/* drabinka wysokości */}
            <g class="tk__ladder" data-ladder>
              <line x1="52" y1="12" x2="52" y2="242" stroke="var(--line-2)" stroke-width="1"/>
            </g>

            {/* morze */}
            <g clip-path="url(#plot)">
              <rect x="52" y="218" width="460" height="20" fill="url(#horizonGlow)"/>
              <rect x="52" y="238" width="460" height="62" fill="url(#sea)"/>
              <rect x="140" y="242" width="290" height="3" fill="url(#spec)"/>
              <g stroke="var(--phos-2)" stroke-width=".8" opacity=".28">
                <line x1="52" y1="247" x2="512" y2="247"/>
                <line x1="52" y1="257" x2="512" y2="257"/>
                <line x1="52" y1="270" x2="512" y2="270"/>
                <line x1="52" y1="286" x2="512" y2="286"/>
              </g>
              <line x1="52" y1="238" x2="512" y2="238" stroke="var(--phos-2)" stroke-width="1.4" opacity=".9"/>
            </g>
            <text x="58" y="254" class="tk__lbl tk__lbl--bright">{L.seaLevel}</text>

            {/* linia obserwacji sprzed sekundy — mechanizm paralaksy */}
            <g clip-path="url(#plot)">
              <line id="ghost" x1="0" y1="0" x2="0" y2="0"
                    stroke="var(--fg-faint)" stroke-width="1" stroke-dasharray="2 4" opacity=".55"/>
              <g id="ghostObs" opacity=".4">
                <path d="M-7 0h13M0 -3v6M4 -2.5l6 2.5-6 2.5z" stroke="var(--fg-faint)" stroke-width="1.2" fill="var(--fg-faint)"/>
              </g>
            </g>

            {/* kąt zejścia */}
            <path id="angArc" d="" fill="none" stroke="var(--amber)" stroke-width="1.1" opacity=".8"/>
            <line id="horizRef" x1="0" y1="0" x2="0" y2="0" stroke="var(--amber-dim)" stroke-width="1" stroke-dasharray="3 3"/>
            <text id="angLbl" class="tk__lbl tk__lbl--amber" x="0" y="0"></text>

            {/* linia obserwacji + wymiar zasięgu */}
            <g clip-path="url(#plot)">
              <line id="los" x1="0" y1="0" x2="0" y2="0" stroke="url(#losg)" stroke-width="1.6"/>
              <g id="rangeDim" opacity=".9">
                <line id="rangeLine" x1="0" y1="0" x2="0" y2="0" stroke="var(--phos-dim)" stroke-width=".9"/>
                <line id="rangeT1" x1="0" y1="0" x2="0" y2="0" stroke="var(--phos-dim)" stroke-width="1.2"/>
                <line id="rangeT2" x1="0" y1="0" x2="0" y2="0" stroke="var(--phos-dim)" stroke-width="1.2"/>
              </g>
              <text id="rangeLbl" class="tk__lbl tk__lbl--bright" x="0" y="0" text-anchor="middle"></text>
            </g>

            {/* obserwator */}
            <g id="obs">
              <circle r="19" fill="url(#glow)"/>
              <path d="M-9 0h16M0 -4v8M5 -3.5l8 3.5-8 3.5z" stroke="var(--phos-2)" stroke-width="1.5"
                    fill="var(--phos-2)" stroke-linejoin="round"/>
              <line x1="-2" y1="-13" x2="24" y2="-13" stroke="var(--phos-dim)" stroke-width="1.1"/>
              <path d="M24 -13l-5.5 -2.4v4.8z" fill="var(--phos-dim)"/>
              <text x="-2" y="-20" class="tk__lbl">{L.observer}</text>
            </g>

            {/* obiekt */}
            <g id="tgt">
              <circle class="tk__ping" r="9" fill="none" stroke="var(--phos-2)" stroke-width="1"/>
              <circle r="4.6" fill="none" stroke="var(--phos-2)" stroke-width="1.5"/>
              <circle r="1.7" fill="var(--phos-2)"/>
              <text id="tgtLbl" x="12" y="4" class="tk__lbl tk__lbl--bright">{L.target}</text>
            </g>
            <line id="drop" x1="0" y1="0" x2="0" y2="250" stroke="var(--line-2)" stroke-width="1" stroke-dasharray="2 3"/>
            <text id="dropLbl" class="tk__lbl" x="0" y="0" text-anchor="middle"></text>

            {/* rogi celownicze — spójne z resztą serwisu */}
            <g stroke="var(--phos-dim)" stroke-width="1" opacity=".5" fill="none">
              <path d="M4 16V4h12M508 16V4h-12M4 288v8h12M512 288v8h-12"/>
            </g>
          </svg>

          <div class="tk__legend">
            <span><i class="tk__k tk__k--los"></i>{L.legLos}</span>
            <span><i class="tk__k tk__k--ghost"></i>{L.legGhost}</span>
            <span><i class="tk__k tk__k--ang"></i>{L.legAng}</span>
          </div>

          <div class="tk__out">
            <div class="tk__row"><span>{L.outRange}</span><b id="o-range">—</b></div>
            <div class="tk__row"><span>{L.outApparent}</span><b id="o-app">—</b></div>
            <div class="tk__row"><span>{L.outParallax}</span><b id="o-par">—</b></div>
            <div class="tk__row tk__row--big"><span>{L.outTarget}</span><b id="o-tgt">—</b></div>
          </div>
        </div>
      </div>

      <div class="tk__verdict">
        <p class="label" style="margin:0 0 .5rem">{L.verdictTitle}</p>
        <p id="verdict" style="margin:0;font-size:1.02rem;color:var(--fg)"></p>
      </div>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:3rem">
    <details class="tk__ass">
      <summary class="label">{L.assumptionsTitle}</summary>
      <ul>{ASSUMPTIONS.map(a => <li>{a}</li>)}</ul>
    </details>
  </section>

  <hr class="rule" />

  <section class="wrap section">
    <div class="grid grid--2" style="gap:2.5rem;background:none;border:0">
      <div>
        <p class="label label--phos" style="margin-bottom:.7rem">02</p>
        <h2 style="font-size:clamp(1.3rem,2.6vw,1.8rem);margin:0 0 .8rem">{L.bokehTitle}</h2>
        <p class="dim" style="font-size:.95rem;max-width:52ch">{L.bokehLead}</p>
        <div class="filters" style="margin-top:1.2rem">
          <span class="label" style="margin-right:.4rem">{L.bokehPick}</span>
          <button class="f" data-ap="3" aria-pressed="true">▲ 3</button>
          <button class="f" data-ap="4" aria-pressed="false">◆ 4</button>
          <button class="f" data-ap="6" aria-pressed="false">⬢ 6</button>
          <button class="f" data-ap="0" aria-pressed="false">● ∞</button>
        </div>
      </div>
      <div class="panel corners" style="padding:1.5rem;display:grid;place-items:center;min-height:230px">
        <svg viewBox="0 0 260 180" style="width:100%" role="img" aria-label={L.bokehAlt}>
          <rect width="260" height="180" fill="#05090A"/>
          <g id="bokeh"></g>
        </svg>
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section class="wrap section" style="padding-bottom:5rem">
    <div class="grid grid--2" style="gap:2.5rem;background:none;border:0">
      <div>
        <p class="label label--phos" style="margin-bottom:.7rem">03</p>
        <h2 style="font-size:clamp(1.3rem,2.6vw,1.8rem);margin:0 0 .8rem">{L.angularTitle}</h2>
        <p class="dim" style="font-size:.95rem;max-width:52ch">{L.angularLead}</p>
        <div class="tk__f" style="margin-top:1.4rem;max-width:360px">
          <label for="ad"><span>{L.angDistance}</span><output id="ad-out">1 000 m</output></label>
          <input id="ad" type="range" min="3" max="2000" step="1" value="1000" />
        </div>
        <p class="bigscore" style="margin-top:1rem"><b id="ad-size">17.5</b><span>m</span></p>
        <p class="label" style="margin:0">{L.angSize}</p>
      </div>
      <div class="panel corners" style="padding:1.5rem;display:grid;place-items:center;min-height:230px">
        <svg viewBox="0 0 260 200" style="width:100%" role="img" aria-label={L.angCompareAlt}>
          <rect width="260" height="200" fill="#05090A"/>
          <line x1="20" y1="110" x2="240" y2="110" stroke="var(--line-2)" stroke-width=".8" stroke-dasharray="3 4"/>

          <ellipse id="ac-obj" cx="130" cy="66" rx="40" ry="11" fill="var(--phos)" fill-opacity=".14"
                   stroke="var(--phos)" stroke-width="1.6"/>
          <text x="130" y="24" text-anchor="middle" class="tk__lbl tk__lbl--bright" id="ac-obj-lbl">17.5 m</text>

          {/* Odnośnik o znanej rozpiętości, z przodu — sylwetka niska, więc nie wchodzi na obiekt */}
          <g id="ac-ref" transform="translate(130,152) scale(1)">
            <g fill="var(--fg-faint)" opacity=".6">
              <path d="M-48 5 L-9 -1 L9 -1 L48 5 L48 9 L9 4 L-9 4 L-48 9 Z"/>
              <ellipse cx="0" cy="0" rx="7" ry="9"/>
              <path d="M-2.5 -9 L-1 -25 L1.5 -25 L3 -9 Z"/>
              <ellipse cx="-21" cy="8" rx="5" ry="4"/>
              <ellipse cx="21" cy="8" rx="5" ry="4"/>
            </g>
          </g>
          <text x="130" y="190" text-anchor="middle" class="tk__lbl">{L.angRef}</text>
        </svg>
      </div>
    </div>
    <p class="dim" style="margin-top:2.5rem;max-width:70ch;font-size:.92rem">{L.footer}</p>
    <a class="btn btn--ghost" href={path(lang, '/cases/gofast-2015')} style="margin-top:1.5rem">
      {en ? 'Read the GOFAST case file' : 'Zobacz akta sprawy GOFAST'}
    </a>
  </section>

  <script is:inline define:vars={{ lang, en }}>
  (() => {
    const $ = id => document.getElementById(id);
    const FT = 0.3048, KT = 0.514444, NM = 1852;
    const nf = new Intl.NumberFormat(lang === 'pl' ? 'pl-PL' : 'en-US');
    const fx = (v, d) => new Intl.NumberFormat(lang === 'pl' ? 'pl-PL' : 'en-US',
      { minimumFractionDigits: d, maximumFractionDigits: d }).format(v);

    const S = { ht: $('ht'), ho: $('ho'), th: $('th'), vo: $('vo'), om: $('om') };
    const DEFAULTS = { ht: 13000, ho: 25000, th: 22, vo: 369, om: 1.14 };

    function speedWords(ms) {
      const kmh = ms * 3.6;
      if (en) {
        if (kmh < 40) return ['at walking-to-cycling pace', 'This is what a drifting balloon does.'];
        if (kmh < 90) return ['at roughly wind speed', 'This is the published resolution of GOFAST: a slow object carried by the wind.'];
        if (kmh < 300) return ['at light-aircraft speed', 'Unremarkable for anything with an engine.'];
        if (kmh < 900) return ['at airliner speed', 'Fast, but entirely conventional.'];
        if (kmh < 2000) return ['at fighter-jet speed', 'Achievable by existing military aircraft.'];
        return ['at hypersonic speed', 'This is the figure quoted when the object is assumed to sit at the surface — and that assumption is exactly what the video cannot establish.'];
      }
      if (kmh < 40) return ['w tempie spaceru lub roweru', 'Tak zachowuje się dryfujący balon.'];
      if (kmh < 90) return ['mniej więcej z prędkością wiatru', 'To jest opublikowane rozwiązanie GOFAST: powolny obiekt niesiony wiatrem.'];
      if (kmh < 300) return ['z prędkością małego samolotu', 'Nic nadzwyczajnego dla czegokolwiek z silnikiem.'];
      if (kmh < 900) return ['z prędkością samolotu pasażerskiego', 'Szybko, ale całkowicie konwencjonalnie.'];
      if (kmh < 2000) return ['z prędkością myśliwca', 'Osiągalne dla istniejących maszyn wojskowych.'];
      return ['z prędkością hipersoniczną', 'To jest liczba podawana, gdy założymy, że obiekt jest przy powierzchni, a tego właśnie nagranie nie potrafi ustalić.'];
    }

    function calc() {
      const ht = +S.ht.value, ho = +S.ho.value, th = +S.th.value, vo = +S.vo.value, om = +S.om.value;
      $('ht-out').textContent = nf.format(ht) + ' ft';
      $('ho-out').textContent = nf.format(ho) + ' ft';
      $('th-out').textContent = fx(th, 1) + '°';
      $('vo-out').textContent = nf.format(vo) + ' kt';
      $('om-out').textContent = fx(om, 2) + ' °/s';

      const dh = Math.max(ho - ht, 0) * FT;
      const rad = th * Math.PI / 180;
      const R = dh > 0 ? dh / Math.sin(rad) : 0;
      const vApp = (om * Math.PI / 180) * R;
      const vPar = vo * KT * Math.cos(rad);
      const vTgt = Math.abs(vApp - vPar);

      $('o-range').textContent = R > 0 ? fx(R / NM, 2) + ' NM' : '—';
      $('o-app').textContent = fx(vApp * 3.6, 0) + ' km/h';
      $('o-par').textContent = fx(vPar * 3.6, 0) + ' km/h';
      $('o-tgt').textContent = fx(vTgt * 3.6, 0) + ' km/h';

      const [w, note] = speedWords(vTgt);
      $('verdict').innerHTML = (en
        ? `At an assumed altitude of <b>${nf.format(ht)} ft</b> the same footage implies an object moving <b>${w}</b>. ${note}`
        : `Przy zakładanej wysokości <b>${nf.format(ht)} ft</b> to samo nagranie oznacza obiekt poruszający się <b>${w}</b>. ${note}`);

      // ——— schemat geometrii
      const OX = 118, SEA = 238, TOPY = 26, MAXFT = 40000, XMAX = 498;
      const yFor = ft => SEA - (ft / MAXFT) * (SEA - TOPY);
      const set = (id, a) => { const e = $(id); for (const k in a) e.setAttribute(k, a[k]); };

      const oy = yFor(ho);
      let ty = yFor(ht);
      let tx = OX + (ty - oy) / Math.tan(rad);
      let offscale = false;
      if (!isFinite(tx) || tx > XMAX) { tx = XMAX; ty = oy + (XMAX - OX) * Math.tan(rad); offscale = true; }

      const dx = tx - OX, dy = ty - oy;
      const len = Math.hypot(dx, dy) || 1;
      const ux = dx / len, uy = dy / len;
      const deg = Math.atan2(dy, dx) * 180 / Math.PI;

      set('obs', { transform: `translate(${OX},${oy})` });
      set('tgt', { transform: `translate(${tx},${ty})` });
      const flip = tx > 424;
      set('tgtLbl', { x: flip ? -12 : 12, y: ty > SEA - 20 ? -12 : 4, 'text-anchor': flip ? 'end' : 'start' });
      $('tgt').style.opacity = offscale ? '.45' : '1';
      set('los', { x1: OX, y1: oy, x2: tx, y2: ty });
      set('drop', { x1: tx, x2: tx, y1: ty + 10, y2: SEA });

      // wysokość obiektu przy linii opadania
      set('dropLbl', { x: tx + (flip ? -10 : 10), y: (ty + SEA) / 2, 'text-anchor': flip ? 'end' : 'start' });
      $('dropLbl').textContent = ht > 0 ? nf.format(ht) + ' ft' : '';

      // kąt zejścia przy obserwatorze
      const AR = 38;
      set('horizRef', { x1: OX, y1: oy, x2: OX + 80, y2: oy });
      set('angArc', { d: `M${OX + AR} ${oy} A${AR} ${AR} 0 0 1 ${OX + AR * Math.cos(rad)} ${oy + AR * Math.sin(rad)}` });
      set('angLbl', { x: OX + 68 * Math.cos(rad / 2) + 6, y: oy + 68 * Math.sin(rad / 2) + 4 });
      $('angLbl').textContent = fx(th, 1) + '\u00B0';

      // linia wymiarowa zasięgu, równolegle do linii obserwacji
      const px = uy * 14, py = -ux * 14;
      const ax = OX + ux * 30 + px, ay = oy + uy * 30 + py;
      const bx = tx - ux * 14 + px, by = ty - uy * 14 + py;
      set('rangeLine', { x1: ax, y1: ay, x2: bx, y2: by });
      set('rangeT1', { x1: ax - px * .42, y1: ay - py * .42, x2: ax + px * .42, y2: ay + py * .42 });
      set('rangeT2', { x1: bx - px * .42, y1: by - py * .42, x2: bx + px * .42, y2: by + py * .42 });
      // etykieta zasięgu odsuwa się od łuku kąta, gdy linia jest krótka
      const dimLen = Math.hypot(bx - ax, by - ay) || 1;
      const f = Math.min(.8, Math.max(.5, 100 / dimLen));
      const mx = ax + (bx - ax) * f + uy * 11, my = ay + (by - ay) * f - ux * 11;
      set('rangeLbl', { x: mx, y: my, transform: `rotate(${deg} ${mx} ${my})` });
      $('rangeLbl').textContent = R > 0 ? fx(R / NM, 2) + ' NM' : '';
      $('rangeDim').style.opacity = len > 60 ? '.95' : '0';
      $('rangeLbl').style.opacity = len > 90 ? '1' : '0';

      // wcześniejsza linia obserwacji — to ona wytwarza pozorny ruch
      const GX = OX - 48;
      set('ghost', { x1: GX, y1: oy, x2: tx, y2: ty });
      set('ghostObs', { transform: `translate(${GX},${oy})` });
      const moving = vo > 0;
      $('ghost').style.opacity = moving ? '.55' : '0';
      $('ghostObs').style.opacity = moving ? '.4' : '0';
    }

    // drabinka wysokości — rysowana raz
    (() => {
      const NS = 'http://www.w3.org/2000/svg';
      const g = document.querySelector('[data-ladder]');
      for (const ft of [0, 10000, 20000, 30000, 40000]) {
        const y = 238 - (ft / 40000) * 212;
        const l = document.createElementNS(NS, 'line');
        l.setAttribute('x1', 52); l.setAttribute('y1', y);
        l.setAttribute('x2', ft === 0 ? 52 : 512); l.setAttribute('y2', y);
        l.setAttribute('stroke', 'var(--phos)');
        l.setAttribute('stroke-width', '.6');
        l.setAttribute('opacity', '.09');
        g.appendChild(l);
        const t = document.createElementNS(NS, 'text');
        t.setAttribute('x', 48); t.setAttribute('y', y + 3);
        t.setAttribute('text-anchor', 'end');
        t.setAttribute('class', 'tk__lbl');
        t.textContent = ft ? (ft / 1000) + 'k' : '0';
        g.appendChild(t);
      }
    })();

    Object.values(S).forEach(el => el.addEventListener('input', calc));
    document.querySelectorAll('[data-preset]').forEach(b => b.addEventListener('click', () => {
      const p = b.dataset.preset;
      if (p === 'surface') S.ht.value = 0;
      else if (p === 'real') S.ht.value = 13000;
      else Object.entries(DEFAULTS).forEach(([k, v]) => { S[k].value = v; });
      calc();
    }));
    calc();

    // ——— bokeh
    const bk = $('bokeh');
    const lights = [[70,60,1],[150,45,.7],[196,96,1],[104,120,.55],[46,132,.85],[172,140,.6]];
    function poly(n, cx, cy, r) {
      if (n === 0) return null;
      const pts = [];
      for (let i = 0; i < n; i++) {
        const a = -Math.PI / 2 + (i * 2 * Math.PI) / n;
        pts.push(`${(cx + r * Math.cos(a)).toFixed(1)},${(cy + r * Math.sin(a)).toFixed(1)}`);
      }
      return pts.join(' ');
    }
    function drawBokeh(n) {
      bk.innerHTML = lights.map(([x, y, s]) => {
        const r = 13 * s;
        const inner = n === 0
          ? `<circle cx="${x}" cy="${y}" r="${r}" fill="var(--phos)" opacity=".22"/><circle cx="${x}" cy="${y}" r="${r}" fill="none" stroke="var(--phos-2)" stroke-width="1" opacity=".8"/>`
          : `<polygon points="${poly(n, x, y, r)}" fill="var(--phos)" opacity=".22"/><polygon points="${poly(n, x, y, r)}" fill="none" stroke="var(--phos-2)" stroke-width="1" opacity=".85"/>`;
        return `<g>${inner}<circle cx="${x}" cy="${y}" r="1.1" fill="#fff" opacity=".9"/></g>`;
      }).join('');
    }
    drawBokeh(3);
    document.querySelectorAll('[data-ap]').forEach(b => b.addEventListener('click', () => {
      document.querySelectorAll('[data-ap]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
      drawBokeh(+b.dataset.ap);
    }));

    // ——— angular size
    const ad = $('ad');
    const REF_M = 36, REF_PX = 96;          // rozpiętość odnośnika w metrach i w jednostkach rysunku
    function ang() {
      const d = +ad.value;
      const size = 2 * d * Math.tan(0.5 * Math.PI / 180);
      $('ad-out').textContent = nf.format(d) + ' m';
      $('ad-size').textContent = fx(size, d < 30 ? 2 : 1);

      // wspólna skala: większa z dwóch figur zajmuje 200 jednostek szerokości
      const mPerU = Math.max(size, REF_M) / 190;
      const refU = (REF_M / mPerU) / REF_PX;
      $('ac-ref').setAttribute('transform', `translate(130,150) scale(${refU.toFixed(4)})`);
      const rx = Math.max(0.6, size / mPerU / 2);
      $('ac-obj').setAttribute('rx', rx.toFixed(2));
      $('ac-obj').setAttribute('ry', Math.max(0.6, rx * 0.28).toFixed(2));
      $('ac-obj-lbl').textContent = fx(size, size < 10 ? 2 : 1) + ' m';
    }
    ad.addEventListener('input', ang); ang();
  })();
  </script>
</Base>
