---
import Base from '../layouts/Base.astro';
import { archives } from '../data/archives';

const ST: Record<string, { pl: string; cls: string }> = {
  active: { pl: 'Działa', cls: 'chip--on' },
  closed: { pl: 'Zamknięty', cls: '' },
  transformed: { pl: 'Przekształcony', cls: 'chip--amber' },
};
const open = archives.filter(a => a.publicDb).length;
---
<Base title="Archiwa państwowe" description="Rejestr programów i archiwów państwowych badających UAP — od szwedzkiego dochodzenia z 1946 roku po AARO i GEIPAN.">
  <section class="wrap" style="padding-block:clamp(2.5rem,6vw,4.5rem) 2rem">
    <p class="label label--phos" style="margin-bottom:.8rem">{archives.length} programów · {open} z dostępem publicznym</p>
    <h1 style="font-size:clamp(2rem,5vw,3.4rem)">Archiwa państwowe</h1>
    <p class="lead dim" style="max-width:62ch">
      Anglojęzyczna literatura o UAP opiera się prawie wyłącznie na Blue Book. Tymczasem
      Francja prowadzi publiczną bazę, Włochy nieprzerwany rejestr od 1978 r., Chile publikuje
      rozstrzygnięcia, a pierwsze poważne dochodzenie państwowe przeprowadziła Szwecja — w 1946 r.
    </p>
  </section>

  <section class="wrap" style="padding-bottom:5rem">
    <div class="stack" style="--s:1px;background:var(--line);border:1px solid var(--line)">
      {archives.map(a => (
        <article style="background:var(--void-2);padding:clamp(1.5rem,3.5vw,2.2rem)">
          <div style="display:flex;justify-content:space-between;gap:1.5rem;flex-wrap:wrap;align-items:flex-start">
            <div style="flex:1;min-width:min(100%,320px)">
              <div style="display:flex;gap:.6rem;align-items:center;flex-wrap:wrap;margin-bottom:.7rem">
                <span class="label label--phos">{a.countryName}</span>
                <span class="label">{a.years}</span>
                <span class:list={['chip', ST[a.status].cls]}>{ST[a.status].pl}</span>
                {a.publicDb && <span class="chip chip--on">Baza publiczna</span>}
              </div>
              <h2 style="font-size:clamp(1.2rem,2.4vw,1.6rem);margin:0 0 .3rem">{a.program}</h2>
              <p class="mono dim" style="font-size:.82rem;margin:0 0 1rem">{a.institution}</p>
              <p style="margin:0 0 1rem;color:var(--fg-dim);font-size:.97rem;max-width:78ch">{a.note}</p>
              <p class="label" style="margin:0">Wolumen: <span style="color:var(--fg-dim);letter-spacing:0;text-transform:none;font-weight:400">{a.volume}</span></p>
              {a.url && <p style="margin:.9rem 0 0"><a href={a.url} rel="noopener noreferrer" target="_blank" class="mono" style="font-size:.85rem">Archiwum źródłowe ↗</a></p>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>
