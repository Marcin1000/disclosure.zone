---
import '../styles/global.css';
import Atmos from '../components/Atmos.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { HTML_LANG, path, useT, LOCALES, DEFAULT_LANG, type Lang } from '../i18n';

interface Props {
  title: string; description: string; lang: Lang;
  /** ścieżka bez prefiksu językowego — do przełącznika i hreflang */
  rest?: string;
  ogImage?: string;
}
const { title, description, lang, rest = '/', ogImage } = Astro.props;
const t = useT(lang);
const full = title === 'disclosure.zone' ? title : `${title} — disclosure.zone`;
const site = Astro.site ?? new URL('https://disclosure.zone');
const canonical = new URL(path(lang, rest), site).toString();
const og = ogImage ? new URL(ogImage, site).toString() : new URL('/og/default.png', site).toString();
---
<!doctype html>
<html lang={HTML_LANG[lang]}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {LOCALES.map(l => (
    <link rel="alternate" hreflang={l} href={new URL(path(l, rest), site).toString()} />
  ))}
  <link rel="alternate" hreflang="x-default" href={new URL(path(DEFAULT_LANG, rest), site).toString()} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="disclosure.zone" />
  <meta property="og:locale" content={lang === 'pl' ? 'pl_PL' : 'en_US'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={full} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={og} />
  <meta name="theme-color" content="#06090A" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Newsreader:ital,opsz,wght@0,6..72,200..600;1,6..72,300..400&family=Special+Elite&display=swap" />
</head>
<body>
  <Atmos />
  <a href="#main" class="sr">{t('nav.skip')}</a>
  <Nav lang={lang} />
  <main id="main"><slot /></main>
  <Footer lang={lang} rest={rest} />
  <script>
    const io = new IntersectionObserver((es) => {
      es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.rise').forEach(el => io.observe(el));
  </script>
</body>
</html>
