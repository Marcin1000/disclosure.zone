---
interface Props { size?: number; withType?: boolean; class?: string }
const { size = 30, withType = true, class: cls = '' } = Astro.props;
const uid = 'lg' + Math.random().toString(36).slice(2, 8);
---
<a href="/" class:list={['logo', cls]} aria-label="disclosure.zone — strona główna">
  <svg class="logo__mark" style={`width:${size}px;height:${size}px`} viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id={`${uid}s`} x1="24" y1="24" x2="46" y2="10" gradientUnits="userSpaceOnUse">
        <stop stop-color="var(--phos)" stop-opacity=".55"/>
        <stop offset="1" stop-color="var(--phos)" stop-opacity="0"/>
      </linearGradient>
      <clipPath id={`${uid}c`}><circle cx="24" cy="24" r="22"/></clipPath>
    </defs>
    <g clip-path={`url(#${uid}c)`}>
      <path d="M24 24 L48 8 A28 28 0 0 1 48 24 Z" fill={`url(#${uid}s)`}/>
    </g>
    <circle cx="24" cy="24" r="22" stroke="var(--phos-dim)" stroke-width="1.6"/>
    <circle cx="24" cy="24" r="14.5" stroke="var(--phos-dim)" stroke-width="1" opacity=".62"/>
    <circle cx="24" cy="24" r="7" stroke="var(--phos-dim)" stroke-width="1" opacity=".4"/>
    <g stroke="var(--phos)" stroke-width="1.6" opacity=".8">
      <path d="M24 0.5v6M24 41.5v6M0.5 24h6M41.5 24h6"/>
    </g>
    <path d="M24 24 L46.5 9.5" stroke="var(--phos)" stroke-width="1.3" opacity=".85"/>
    <g transform="rotate(-4 24 31)">
      <rect x="-2" y="27" width="52" height="8.4" fill="var(--paper)"/>
      <rect x="-2" y="27" width="52" height="1" fill="var(--paper-3)" opacity=".55"/>
    </g>
  </svg>
  {withType && <span class="logo__type">DISCLOSURE<i>.ZONE</i></span>}
</a>
