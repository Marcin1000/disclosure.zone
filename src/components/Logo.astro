---
interface Props { size?: number; withType?: boolean; class?: string; href?: string }
const { size = 30, withType = true, class: cls = '', href = '/' } = Astro.props;
const u = 'lg' + Math.random().toString(36).slice(2, 8);
---
<a href={href} class:list={['logo', cls]} aria-label="disclosure.zone">
  <svg class="logo__mark" style={`width:${size}px;height:${size}px`} viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id={`${u}g`} x1="24" y1="24" x2="46" y2="10" gradientUnits="userSpaceOnUse">
        <stop stop-color="var(--phos)" stop-opacity=".5"/>
        <stop offset="1" stop-color="var(--phos)" stop-opacity="0"/>
      </linearGradient>
      <clipPath id={`${u}c`}><circle cx="24" cy="24" r="22"/></clipPath>
      {/* Przerwa w zapisie — ślad po belce redakcyjnej, teraz jako pusta przestrzeń */}
      <mask id={`${u}m`}>
        <rect width="48" height="48" fill="#fff"/>
        <g transform="rotate(-4 24 30)"><rect x="-4" y="27.6" width="56" height="5.2" fill="#000"/></g>
      </mask>
    </defs>
    <g mask={`url(#${u}m)`}>
      <g clip-path={`url(#${u}c)`}><path d="M24 24 L48 8 A28 28 0 0 1 48 24 Z" fill={`url(#${u}g)`}/></g>
      <circle cx="24" cy="24" r="22" stroke="var(--phos-dim)" stroke-width="1.6"/>
      <circle cx="24" cy="24" r="14.5" stroke="var(--phos-dim)" stroke-width="1" opacity=".62"/>
      <circle cx="24" cy="24" r="7" stroke="var(--phos-dim)" stroke-width="1" opacity=".4"/>
      <g stroke="var(--phos)" stroke-width="1.6" opacity=".8"><path d="M24 .5v6M24 41.5v6M.5 24h6M41.5 24h6"/></g>
      <path d="M24 24 L41.2 12.9" stroke="var(--phos)" stroke-width="1.3" opacity=".85"/>
    </g>
  </svg>
  {withType && <span class="logo__type">DISCLOSURE<i>.ZONE</i></span>}
</a>
