---
interface Props { size?: number; withType?: boolean; class?: string; href?: string }
const { size = 30, withType = true, class: cls = '', href = '/' } = Astro.props;
const u = 'lg' + Math.random().toString(36).slice(2, 8);
/* Znak: D jako kopuła radaru (pion + łuk), Z wpisane w kopułę — belki kończą się na łuku. */
---
<a href={href} class:list={['logo', cls]} aria-label="disclosure.zone">
  <svg class="logo__mark" style={`width:${size}px;height:${size}px`} viewBox="0 0 48 48"
       fill="none" stroke-linecap="butt" aria-hidden="true">
    <defs>
      <linearGradient id={`${u}s`} x1="13" y1="24" x2="30" y2="11" gradientUnits="userSpaceOnUse">
        <stop stop-color="var(--phos)" stop-opacity=".28"/>
        <stop offset="1" stop-color="var(--phos)" stop-opacity="0"/>
      </linearGradient>
      <clipPath id={`${u}c`}><path d="M13 7A17 17 0 0 1 13 41Z"/></clipPath>
    </defs>
    {/* przemiat i pierścień zasięgu — czytelne dopiero w większej skali */}
    <g clip-path={`url(#${u}c)`}>
      <path d="M13 24 L13 4 A20 20 0 0 1 31 13 Z" fill={`url(#${u}s)`}/>
      <path d="M13 14A10 10 0 0 1 13 34" stroke="var(--phos-dim)" stroke-width=".9" opacity=".38"/>
    </g>
    <path d="M13 7A17 17 0 0 1 13 41" stroke="var(--phos-dim)" stroke-width="3"/>
    <path d="M13 7V41" stroke="var(--phos)" stroke-width="3.4"/>
    <path d="M17 15H27.4M17 33H27.4" stroke="var(--phos)" stroke-width="2.6"/>
    <path d="M27.4 15L17 33" stroke="var(--phos-2)" stroke-width="2.8"/>
  </svg>
  {withType && <span class="logo__type">DISCLOSURE<i>.ZONE</i></span>}
</a>
