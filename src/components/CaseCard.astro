---
import { STATUS, overall, bi, type Scores } from '../lib/scoring';
import type { Lang } from '../i18n';
interface Props {
  href: string; title: string; summary: string; dateDisplay: string;
  countryName: string; status: string; tier: number; scores: Scores; lang: Lang;
}
const { href, title, summary, dateDisplay, countryName, status, tier, scores, lang } = Astro.props;
const st = STATUS[status];
/**
 * Skrót streszczenia na kartę. Tnie na granicy słowa, a jeśli cięcie wypada
 * w środku cytatu, cofa się przed cudzysłów otwierający; gdy cytat zaczyna się
 * za wcześnie, by się cofnąć, domyka go po wielokropku. Inaczej karta zostawiałaby
 * otwarty cudzysłów, a cytat wyglądałby na pełne słowa dokumentu.
 * Gdy cięcie wypada na końcu zdania, karta kończy się kropką, bez wielokropka;
 * kropka po skrócie stopnia albo tytułu nie kończy zdania, więc skrót odpada.
 */
const ABBR = /(?:^|\s)(?:Lt|Capt|Col|Maj|Gen|Sgt|Cpl|Pvt|Cdr|Adm|Dr|Mr|Mrs|Ms|St|No|Nos|pp?|vol|Jr|Sr|kpt|por|ppor|gen|sierż|św|np|tzw|ok|s|ul|im)\.$/i;
function clip(s: string, max = 190): string {
  if (s.length <= max) return s;
  const tidy = (t: string) => t.replace(/[\s,;:–(]+$/, '');
  let cut = s.lastIndexOf(' ', max - 2);
  if (cut < max * 0.6) cut = max - 2;
  let out = tidy(s.slice(0, cut));
  let depth = 0, open = -1;
  for (let i = 0; i < out.length; i++) {
    const ch = out[i];
    if (ch === '“' || ch === '„') { if (depth === 0) open = i; depth++; }
    else if (ch === '”' && depth > 0) depth--;
  }
  if (depth > 0) {
    if (open >= 80) out = tidy(out.slice(0, open));
    else return out + '…”';
  }
  if (ABBR.test(out)) out = tidy(out.replace(/\S+$/, ''));
  else if (/[.!?][”’)]*$/.test(out)) return out;
  return out + '…';
}
const short = clip(summary);
---
<a class:list={['case', st.cls]} href={href}>
  <div class="case__meta">
    <span class="label mono">{dateDisplay}</span>
    <span class="label mono" style="color:var(--phos-dim)">{countryName}</span>
    {tier === 1 && <span class="label mono" style="color:var(--amber)">◆</span>}
  </div>
  <h3 class="case__t">{title}</h3>
  <p class="case__sum">{short}</p>
  <div class="case__foot">
    <span class="chip">{bi(st.label, lang)}</span>
    <span class="chip chip--on">{overall(scores).toFixed(1)}/5</span>
  </div>
</a>
