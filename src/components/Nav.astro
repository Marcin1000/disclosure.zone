---
import Logo from './Logo.astro';
import { path, useT, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  ['cases', 'nav.cases'], ['map', 'nav.map'], ['claims', 'nav.claims'],
  ['archives', 'nav.archives'], ['toolkit', 'nav.toolkit'], ['methodology', 'nav.method'],
] as const;
---
<header class="nav">
  <div class="wrap nav__in">
    <Logo href={path(lang)} />
    <nav class="nav__links" aria-label={t('nav.main')}>
      {links.map(([slug, key]) => {
        const href = path(lang, `/${slug}`);
        return <a href={href} aria-current={here === href || here.startsWith(href + '/') ? 'page' : undefined}>{t(key)}</a>;
      })}
    </nav>
  </div>
</header>
